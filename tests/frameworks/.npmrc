# This suite installs React 18 and React 19 side by side (react18 / react-dom18 are npm aliases).
# react-dom@18 declares `peer react@^18`, which npm 7+ refuses next to the root react@19 — the two
# apps are bundled separately by build.mjs, so the peer warning is a false alarm here.
legacy-peer-deps=true
audit=false
fund=false
